# Copy this file to .env and fill in your API keys

# API Keys (Required)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort for gpt-oss models: none | default | low | medium | high
GROQ_REASONING_EFFORT=low

# SQLite Database
# Optional. Leave empty to use the default location (<repo>/data/app.db).
# Set an absolute path to override (e.g. /data/app.db when running in Docker).
SQLITE_PATH=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Mock Provider Flags (set to true for testing without real APIs)
FORCE_MOCK_STT=false
FORCE_MOCK_LLM=false
FORCE_MOCK_TTS=false

# Use dummy customer data instead of DB
USE_DUMMY_DATA=false

# Copy this file to .env and fill in your API keys

# API Keys (Required)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# MySQL Database (Required)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=performance_coaching

# PostgreSQL (Optional - for future use)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debt_sim

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Mock Provider Flags (set to true for testing without real APIs)
FORCE_MOCK_STT=false
FORCE_MOCK_LLM=false
FORCE_MOCK_TTS=false

# Use dummy customer data instead of DB
USE_DUMMY_DATA=false
